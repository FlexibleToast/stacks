{
  "log": {
    "level": "info"
  },
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "dedupe": true,
    "gc": true,
    "gcInterval": "168h",
    "retention": {
      "delay": "24h",
      "policies": [
        {
          "repositories": ["homeserver/hermes"],
          "deleteUntagged": true,
          "keepTags": [
            {
              "patterns": [".*"],
              "pushedWithin": "672h",
              "mostRecentlyPushedCount": 3
            }
          ]
        }
      ]
    }
  },
  "http": {
    "address": "0.0.0.0",
    "port": "8080",
    "externalUrl": "https://zot.mcdade.app",
    "readTimeout": "30m",
    "writeTimeout": "30m",
    "compat": ["docker2s2"],
    "auth": {
      "openid": {
        "providers": {
          "oidc": {
            "name": "authentik",
            "credentialsFile": "/etc/zot/credentials.json",
            "issuer": "https://auth.mcdade.app/application/o/zot/",
            "keypath": "",
            "scopes": ["openid", "profile", "email", "groups"],
            "claimMapping": { "username": "preferred_username" }
          }
        }
      }
    },
    "accessControl": {
      "adminPolicy": { "users": ["FlexibleToast"], "actions": ["read", "create", "update", "delete"] },
      "repositories": {
        "**": { "anonymousPolicy": ["read"], "defaultPolicy": ["read"] },
        "redhat": { "anonymousPolicy": [], "policies": [{ "groups": ["redhat"], "actions": ["read", "create", "update", "delete"] }] },
        "redhat/**": { "anonymousPolicy": [], "policies": [{ "groups": ["redhat"], "actions": ["read", "create", "update", "delete"] }] },
        "docker/**": { "anonymousPolicy": [], "defaultPolicy": ["read"] },
        "ghcr/**": { "anonymousPolicy": [], "defaultPolicy": ["read"] },
        "quay/**": { "anonymousPolicy": [], "defaultPolicy": ["read"] },
        "forgejo/**": { "anonymousPolicy": [], "defaultPolicy": ["read"] }
      }
    }
  },
  "extensions": {
    "ui": {"enable": true},
    "search": {
      "enable": true,
      "cve": {
        "updateInterval": "24h"
      }
    },
    "metrics": {
      "enable": true,
      "prometheus": {
        "path": "/metrics"
      }
    },
    "sync": {
      "credentialsFile": "/etc/zot/sync-credentials.json",
      "registries": [
        {
          "urls": ["https://quay.io"],
          "onDemand": true,
          "manifestCheckInterval": "120h",
          "content": [
            { "prefix": "/**", "destination": "/quay" }
          ]
        },
        {
          "urls": ["https://registry.redhat.io"],
          "onDemand": true,
          "manifestCheckInterval": "168h",
          "syncTimeout": "12h",
          "content": [
            { "prefix": "/**", "destination": "/redhat" }
          ]
        },
        {
          "urls": ["https://ghcr.io"],
          "onDemand": true,
          "manifestCheckInterval": "120h",
          "content": [
            { "prefix": "/**", "destination": "/ghcr" }
          ]
        },
        {
          "urls": ["https://git.mcdade.app"],
          "onDemand": true,
          "manifestCheckInterval": "24h",
          "content": [
            { "prefix": "/**", "destination": "/forgejo" }
          ]
        },
        {
          "urls": ["https://docker.io"],
          "onDemand": true,
          "manifestCheckInterval": "120h",
          "content": [
            { "prefix": "/**", "destination": "/docker" }
          ]
        }
      ]
    }
  }
}
