FROM node:22-alpine
RUN npm install -g mcp-redhat-knowledge supergateway
ENV REDHAT_TOKEN=""
EXPOSE 9525
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:9525/mcp || exit 1
CMD ["supergateway", "--stdio", "mcp-redhat-knowledge", "--port", "9525", "--outputTransport", "streamableHttp"]
