environment:
    PAPERLESS_APPS: allauth.socialaccount.providers.openid_connect
    PAPERLESS_SOCIALACCOUNT_PROVIDERS: ${AUTHENTIK_SECRET}
    PAPERLESS_LOGOUT_REDIRECT_URL: "https://${AUTHENTIK_URL}/application/o/paperless/end-session/"
    PAPERLESS_SOCIAL_AUTO_SIGNUP: true
    PAPERLESS_SOCIALACCOUNT_ALLOW_SIGNUPS: true